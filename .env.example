# --- База данных ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=polymarket_bot
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# --- Режим ---
# true = ничего не отправляется на биржу: WS-стакан читается по-настоящему,
#        но ордера (и рыночные, и лимитные) только эмулируются — причём
#        честно, с проходом по реальным уровням стакана (VWAP), а не по
#        единственной лучшей цене. См. раздел про эмуляцию в README.
SMOKE_START=true

# --- Кошелёк / Polymarket (нужны только когда SMOKE_START=false) ---
PRIVATE_KEY=
RPC_URL=https://polygon-rpc.com
CLOB_HOST=https://clob.polymarket.com
SIGNATURE_TYPE=0
FUNDER_ADDRESS=
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=

# --- Потоки (актив × таймфрейм) ---
# Раньше был один общий MARKET_ASSETS + один общий BET_AMOUNT на все активы
# сразу (общий счётчик шагов — источник гонки stepNumber, см. BACKLOG п.3).
# Теперь каждый независимый поток описывается отдельным объектом в JSON-
# массиве: свой Attempt, свой прогресс, своя реинвест-прогрессия стейка
# (baseStake — старт/сброс после проигрыша, см. BACKLOG п.1).
#
# kind:
#   "interval"   — слаг = `${slugPrefix}-${unix_start}` (5m/15m Up/Down)
#   "hourly-et"  — слаг = календарная ET-строка (часовые Up/Down), напр.
#                  bitcoin-up-or-down-september-9-2026-7pm-et
# Форматы проверены вручную на живых слагах перед реализацией (см. README).
# 4ч/1д сознательно не включены (см. BACKLOG п.5 — непригодны как критерий
# готовности "3×500" по времени набора статистики).
#
# Необязательное поле `atrCandles` переопределяет FEED_ATR_CANDLES для
# конкретного потока (см. ниже секцию про фид) — у часового потока задано 8
# вместо глобальных 20, иначе прогрев ATR-гейта занял бы 20 часов.
STREAMS_CONFIG=[{"streamKey":"btc-updown-5m","kind":"interval","intervalSec":300,"slugPrefix":"btc-updown-5m","baseStake":5},{"streamKey":"btc-updown-15m","kind":"interval","intervalSec":900,"slugPrefix":"btc-updown-15m","baseStake":5},{"streamKey":"bitcoin-up-or-down","kind":"hourly-et","intervalSec":3600,"etSlugBase":"bitcoin-up-or-down","baseStake":5,"atrCandles":8}]

# --- Размер перерасхода ---
# Реальный минимальный размер ордера на бирже читается с самой биржи в
# реальном времени (обычно около 5 токенов). Бот не тратит молча больше,
# чем (текущий стейк потока) * MAX_OVERSPEND_MULTIPLIER — иначе шаг просто
# пропускается.
MAX_OVERSPEND_MULTIPLIER=1.5

# Минимальная доля стейка шага, которую обязательно нужно суметь реально
# исполнить по стакану (VWAP-проход), чтобы вообще засчитать вход. Если
# глубины хватает меньше — это, скорее всего, дребезг тонкой одиночной
# заявки, а не настоящее направление рынка, и шаг просто пропускается.
MIN_FILL_RATIO=0.5

# --- Правило A: агрессивный маркет-тейк (FAK) ---
MIN_MARKET_PRICE=0.99
MAX_MARKET_PRICE=0.999

# --- Окно входа: чем раньше пытаться войти, тем менее уверенно рынок ещё
# определился с направлением. По факту оба реальных слива случились именно
# на ранних входах (маркетмейкер давал ¢99 за 2-3 минуты до закрытия, цена
# потом успевала развернуться). Пока не наступило последние
# LAST_ENTRY_WINDOW_SEC секунд до закрытия — не пытаемся войти вообще, ни
# маркетом (Правило A), ни лимиткой (Правило B). Лучше пропустить шаг, чем
# рисковать капиталом на неопределившемся рынке.
LAST_ENTRY_WINDOW_SEC=60

# --- Правило B: лимитка-фолбэк, когда у фаворита реально нет предложений ---
# Тиры имеют смысл только ВНУТРИ окна входа выше (LIMIT_TIER2/3_SECONDS
# должны быть <= LAST_ENTRY_WINDOW_SEC, иначе T1/T2 попросту недостижимы —
# время уже пройдёт порог LAST_ENTRY_WINDOW_SEC раньше, чем порог тира).
FAVORITE_BID_THRESHOLD=0.90
LIMIT_TIER1_PRICE=0.99
LIMIT_TIER2_PRICE=0.995
LIMIT_TIER3_PRICE=0.999
LIMIT_TIER2_SECONDS=40
LIMIT_TIER3_SECONDS=15

# --- Внешний ценовой фид — нужен для дельты цена/референс и ATR-гейта входа. ---
#
# ИСТОЧНИК ПО УМОЛЧАНИЮ ИЗМЕНЁН НА CHAINLINK (после разбора реальных сливов
# BTC/SOL, см. README): раньше здесь стоял Binance/Bybit — приближение,
# которое во время резких движений расходится с тем, чем Polymarket реально
# резолвит крипто-маркеты, на 0.3-0.8% на 10-30 секунд. В бинарном маркете у
# границы ¢99 этого достаточно, чтобы диагностика "цена уверенно ушла в
# сторону" оказалась просто неверной. Chainlink здесь — это буквально тот же
# фид (data.chain.link), которым Polymarket резолвит Up/Down маркеты,
# получен через официальный публичный Polymarket RTDS
# (wss://ws-live-data.polymarket.com, топик crypto_prices_chainlink,
# см. docs.polymarket.com) — БЕЗ API-ключа.
#
# Через запятую — порядок провайдеров; после FEED_PROVIDER_FAIL_THRESHOLD
# подряд неудачных попыток подключения к текущему бот сам переключается на
# следующего по кругу. binance/bybit оставлены как фолбэк на случай простоя
# RTDS — их значения ВСЕГДА помечаются источником в логах/логах сделок
# (priceSource), не выдаются молча за то же самое, что chainlink.
FEED_PROVIDERS=chainlink,binance,bybit
FEED_PROVIDER_FAIL_THRESHOLD=3
# Опционально: прокси для WS-подключения (http://, https:// или socks5://) —
# на случай, если геоблок или сетевые ограничения актуальны для ВСЕХ
# провайдеров из FEED_PROVIDERS сразу. Пусто = подключаться напрямую.
FEED_PROXY_URL=

# Сколько ПРОШЛЫХ ЗАВЕРШЁННЫХ ОКОН этого же таймфрейма усредняем в ATR —
# глобальный дефолт, можно переопределить на конкретный поток полем
# `atrCandles` внутри STREAMS_CONFIG (см. пример там выше — у часового потока
# уже уменьшено до 8, иначе прогрев был бы 20 часов).
#
# ВАЖНО, куда делся FEED_CANDLE_MS: одна свеча ATR теперь = РОВНО ОДНО ОКНО
# потока (intervalSec), а не его доля. Была промежуточная версия, где свеча
# считалась как intervalSec/FEED_ATR_CANDLES (дробили окно на куски) — она
# ВСЁ ЕЩЁ была математически неверна: сравнивать дрейф цены за целое окно с
# размахом внутри 1/20 этого окна некорректно, потому что при случайном
# блуждании размах растёт примерно как √(время) — то есть даже на чистом
# шуме без всякого направленного движения такое сравнение само по себе
# давало бы коэффициент ≈√20≈4.5, а не ≈1. Сейчас свеча ATR = целое
# завершённое окно, ATR = средний размах последних N таких окон — прямое,
# без пересчётных коэффициентов, сравнение "насколько обычно двигается цена
# за один такой же по длине маркет". Плата — более долгий прогрев (N*intervalSec):
# 100 минут для 5m, 5 часов для 15m, у 1h уменьшено до 8 окон = 8 часов.
# Пока прогрев не набрался — ATR недоступен, что при ENTRY_FILTER_ENABLED=true
# уходит в fail-closed (пропуск шага), как и полное отсутствие тиков.
# СЕССИЯ 6, п.6: прогрев ATR больше не идёт с нуля при каждом рестарте —
# PriceFeedService теперь бэкафиллит нужное число прошлых свечей из БД
# (таблица price_candles) и, если там не хватает, догружает недостающее
# через публичный Binance REST klines (без ключа, доступен в NETWORK
# allowed-domains как api.binance.com — уже используется как фолбэк-фид, тут
# используется только для истории). Новых переменных окружения не требуется.
FEED_ATR_CANDLES=20
# Защитный нижний предел размера свечи (на случай экзотически маленького
# intervalSec) — при обычных 5m/15m/1h ни на что не влияет.
FEED_MIN_CANDLE_MS=1000

# Тик протухает быстрее, чем можно подумать: если последний тик по фиду
# старше этого порога — диагностика (и, при включённом ATR-гейте, вход)
# считается недоступной, а не берётся "какая есть". Красный флаг у самого
# резолва — не данные, на которые можно положиться (см. дев-разбор в README).
FEED_STALE_MS=5000

# Вотчдог "зомби-соединения" (Сессия 9, см. CONTEXT.md) — если от активного
# провайдера не пришло НИ ОДНОГО трейда дольше этого порога, хотя сокет
# технически ещё OPEN, соединение форсированно разрывается (ws.terminate()),
# чтобы включился обычный реконнект/ротация провайдера. Без этого тихая
# остановка данных на уровне приложения (не TCP-обрыв) никогда не ловилась
# сама — ни 'close', ни 'error' в этом случае не срабатывают, и ATR/диагностика
# могли "недоступны" держаться часами вместо секунд. Должен быть заметно
# больше FEED_STALE_MS (тот — про "не доверяй старой цене", этот — про "фид
# не шлёт вообще ничего", а не про тихий рынок).
FEED_DATA_WATCHDOG_MS=20000

# Сколько храним буфер СЫРЫХ тиков (Сессия 11, см. CONTEXT.md) для поиска
# цены НА ТОЧНЫЙ момент старта окна (referencePrice/страйк), а не "текущей"
# цены на момент, когда мы вообще успели её спросить — между обнаружением
# нового окна и фиксацией снимка проходит 1-3 сетевых round-trip'а
# (fetchMarketBySlug + getBestQuote x2), за которые цена успевает заметно
# отойти от официального страйка Polymarket. Должно быть заметно больше
# суммарной задержки discoveryPollMs + типичных REST round-trip'ов.
FEED_RECENT_TICKS_RETENTION_MS=15000

# Явный маппинг streamKey -> тикер (общий для всех провайдеров — Binance/
# Bybit сами достроят суффикс usdt, Chainlink сам достроит "/usd"), если
# авто-вывод (первый сегмент до дефиса, напр. btc-updown-5m -> btc) не
# подходит — ОБЯЗАТЕЛЕН для часового потока "bitcoin-up-or-down" (авто-вывод
# дал бы тикер "bitcoin", а не "btc").
FEED_SYMBOL_OVERRIDES=bitcoin-up-or-down:btc

# --- ATR-гейт входа ---
# true (по умолчанию, изменено после реальных сливов) = гейт АКТИВНО
# блокирует вход, если дистанция цены от референса окна меньше
# MIN_DISTANCE_ATR_RATIO x ATR — то есть похоже на болтанку у границы, а не
# уверенное движение. Раньше был выключен по умолчанию (SHADOW-режим —
# только считал и писал диагностику, не блокируя), пока не накопится
# статистика по сливам для калибровки порога; статистика накоплена
# (см. реальные сливы eth-updown-5m), теперь гейт включён.
#
# ВАЖНО: если диагностика недоступна (фид не отдал ни одного тика к моменту
# входа — напр. WS отвалился) — при ВКЛЮЧЁННОМ гейте это теперь блокирует
# вход (fail-closed), а не пропускает вслепую (было fail-open). Так и
# задумано: лучше упустить шаг целиком, чем рисковать капиталом без
# понимания, насколько уверенно движение. Если фид ляжет надолго (как в
# инциденте с Binance 451) — бот при этой настройке будет пропускать шаги,
# а не торговать вслепую; это ожидаемое поведение, не баг.
ENTRY_FILTER_ENABLED=true
# Минимальное отношение |цена - референс окна| / ATR, при котором вход разрешён
# (когда ENTRY_FILTER_ENABLED=true). Чем больше — тем строже фильтр. Порог
# пока не откалиброван по большой выборке — при желании ужесточить/ослабить
# смотри на atrRatioAtEntry в market_logs по уже накопленным сделкам.
MIN_DISTANCE_ATR_RATIO=1.5

# Реакция на ситуацию "предыдущий шаг потока ещё не зарезолвлен официально
# Gamma, а по времени пора открывать следующее окно" — реальный race
# condition по сумме ставки, найден и закрыт в Сессии 6/7 (см. CONTEXT.md п.7).
# Три режима:
#   block       — не открывать новое окно, пока не придёт официальный резолв.
#                 Самый безопасный, изредка пропускает шаг при задержке Gamma.
#   pre_resolve — открывать окно, но брать сумму стейка из ПРЕДСКАЗАНИЯ исхода
#                 предыдущего шага по живой цене Chainlink (той же, которой
#                 Gamma и резолвит крипто-маркеты) — см.
#                 TradingService.tryPreResolve. Если предсказание недоступно
#                 или неуверенное (см. PRE_RESOLVE_MIN_ATR_RATIO) — на этом
#                 конкретном тике ведёт себя как block, вслепую не открывает.
#   open        — легаси-режим без защиты вообще (это и есть исходный баг).
#                 Использовать осознанно, не рекомендуется.
PENDING_GATE_MODE=block
# Устарело (Сессия 6) — если PENDING_GATE_MODE не задан явно, старое булево
# значение маппится: true->block, false->open. Оставлено для обратной
# совместимости, новые деплои должны использовать PENDING_GATE_MODE.
# BLOCK_ORDERS_IF_PENDING=true

# Минимальная дистанция |текущая цена - страйк предыдущего шага| / ATR, при
# которой pre_resolve доверяет предсказанию исхода (см. выше). Специально
# строже входного ENTRY_FILTER (MIN_DISTANCE_ATR_RATIO) — здесь ошибка
# означает не пропуск входа, а неверно посчитанную прогрессию стейка.
PRE_RESOLVE_MIN_ATR_RATIO=2

# Потолок числа окон ПОДРЯД, открытых через pre_resolve без хотя бы одного
# официального подтверждения Gamma между ними. Не даёт риску накапливаться
# бесконтрольно, если Gamma зависла на несколько окон подряд — после потолка
# pre_resolve временно откатывается к block, пока не придёт подтверждение.
PRE_RESOLVE_MAX_CHAIN=1

# --- Мониторинг зависшего резолва ---
# Сколько логу разрешено висеть в pending_resolve, прежде чем это считается
# аномалией (предупреждение в логах + /analytics/summary.staleUnresolved).
# Не блокирует торговлю — только сигнализирует.
STALE_RESOLVE_WARN_MS=180000

# --- Профит / банкролл (только для отображения в /analytics/summary) ---
STARTING_BANKROLL=500

# --- Прочее ---
TARGET_STEPS=500
MARKET_DISCOVERY_POLL_MS=1500
RESOLVE_POLL_INTERVAL_MS=10000

PORT=3000