{
  "name": "polymarket-5m-bot",
  "version": "0.1.0",
  "description": "Autonomous NestJS bot: BTC 5m up/down markets on Polymarket, late-window c98-99 entries, step-challenge tracking (attempt/500 steps), Postgres logging, smoke-test mode.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
