    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/typeorm": "^12.0.1",
    "@polymarket/clob-client": "5.8.1",
    "axios": "^1.20.0",
    "ethers": "^5.8.0",
    "https-proxy-agent": "5.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socks-proxy-agent": "7.0.0",
    "typeorm": "^0.3.31",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.6",
    "@types/express": "^5.0.0",
